{
  "name": "actuary",
  "version": "0.1.0",
  "description": "The paying watchdog: autonomous probes that buy from x402 agent services, grade the results, and sell trust scores back to the agent economy.",
  "type": "module",
  "private": true,
  "scripts": {
    "probe": "tsx src/probe/runner.ts",
    "probe:paid": "tsx src/probe/runner.ts --paid",
    "serve": "tsx src/server/index.ts",
    "scores": "tsx src/score/report.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@circle-fin/cli": "^0.0.6",
    "@circle-fin/x402-batching": "^3.2.0",
    "@google/genai": "^2.15.0",
    "express": "^5.2.1"
  }
}

# --- Probe agent (buyer side) ---

# The probe agent's Circle Agent Wallet address (created via `circle wallet create`).
# Leave empty until you have logged in: estimate-mode probes work without it.
PROBE_WALLET_ADDRESS=

# Chain the probe pays on. BASE is Circle's default mainnet; ARC-TESTNET has a faucet.
PROBE_CHAIN=ARC-TESTNET

# Hard per-call ceiling passed to `circle services pay --max-amount` (USDC).
MAX_PER_CALL_USDC=0.05

# Soft daily budget enforced in code before any paid probe fires (USDC).
# The wallet's own spending policy (`circle wallet limit set`) is the hard backstop.
DAILY_BUDGET_USDC=2.00

# --- Score API (seller side) ---

# Address that receives score-lookup payments via Circle Gateway batching.
SELLER_ADDRESS=

# Price of one detailed score lookup.
SCORE_PRICE_USDC=0.001

PORT=8080

# --- Gemini (response-quality grading; satisfies the XPRIZE Gemini requirement) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Circle CLI ---
# The CLI requires one-time Terms acceptance (https://agents.circle.com/terms-of-use).
# After YOU have read and accepted them (run `npx circle terms accept` locally),
# set this to 1 for headless environments (Cloud Run, CI) so the gate doesn't re-prompt.
# CIRCLE_ACCEPT_TERMS=1
